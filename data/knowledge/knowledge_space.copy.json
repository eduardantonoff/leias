'{\n  "document": {\n    "id": "cs229-notes1",\n    "title": "cs229 notes1",\n    "source_type": "pdf",\n    "domain": "Machine Learning",\n    "overview": "An introduction to supervised learning with a primary focus on linear regression, covering its mathematical formulation, optimization techniques, and probabilistic underpinnings."\n
  },\n  "topics": [\n    {\n      "id": "supervised-learning-fundamentals",\n      "title": "Supervised Learning Fundamentals",\n      "summary": "The process of learning a mapping from input features to target variables using a training set of examples.",\n      "context": "Establishes the basic notation and terminology, while distinguishing between regression and classification problems."\n
    },\n    {\n      "id": "linear-regression-model",\n      "title": "Linear Regression Model",\n      "summary": "A method of approximating a target variable as a linear combination of input features parameterized by weights.",\n      "context": "Introduces the hypothesis function and the least-squares cost function used to measure the accuracy of predictions."\n
    },\n    {\n      "id": "gradient-descent-optimization",\n      "title": "Gradient Descent Optimization",\n      "summary": "An iterative search algorithm used to minimize a cost function by repeatedly updating parameters in the direction of steepest decrease.",\n      "context": "Details the LMS update rule and compares the performance and behavior of batch gradient descent versus stochastic gradient descent."\n
    },\n    {\n      "id": "the-normal-equations",\n      "title": "The Normal Equations",\n      "summary": "A closed-form analytical solution for finding the optimal parameters of a linear regression model without iterative steps.",\n      "context": "Utilizes matrix derivatives and linear algebra to derive a direct calculation for the parameter vector theta."\n
    },\n    {\n      "id": "probabilistic-interpretation",\n      "title": "Probabilistic Interpretation",\n      "summary": "The theoretical justification for least-squares regression based on the assumption of independently and identically distributed Gaussian noise.",\n      "context": "Explains why the least-squares cost function is a natural choice from a statistical perspective."\n
    }\n
  ],\n  "concepts": [\n    {\n      "id": "supervised-learning-fundamentals-input-features-and-target-variable",\n      "topic_id": "supervised-learning-fundamentals",\n      "title": "Input Features and Target Variable",\n      "summary": "Input features (x) are the variables used to make a prediction, while the target variable (y) is the output value the model is trying to predict.",\n      "context": "Establishes the basic notation for the variables involved in a supervised learning mapping.",\n      "prerequisite_ids": [],\n      "evidence": [\n        {\n          "page": 2,\n          "section": "Supervised learning",\n          "excerpt": "we’ll use x(i) to denote the “input” variables (living area in this example), also called input features, and y(i) to denote the “output” or target variable that we are trying to predict (price)."\n
        }\n
      ]\n
    },\n    {\n      "id": "supervised-learning-fundamentals-training-example-and-training-set",\n      "topic_id": "supervised-learning-fundamentals",\n      "title": "Training Example and Training Set",\n      "summary": "A training example is a pair consisting of an input and its corresponding target value; a training set is the collection of these examples used to learn the mapping.",\n      "context": "Defines the structure of the data used by the learning algorithm.",\n      "prerequisite_ids": [\n        "supervised-learning-fundamentals-input-features-and-target-variable"\n
      ],\n      "evidence": [\n        {\n          "page": 2,\n          "section": "Supervised learning",\n          "excerpt": "A pair ( x(i),y (i)) is called a training example , and the dataset that we’ll be using to learn—a list of n training examples {(x(i),y (i));i = 1,...,n }—is called a training set."\n
        }\n
      ]\n
    },\n    {\n      "id": "supervised-learning-fundamentals-hypothesis",\n      "topic_id": "supervised-learning-fundamentals",\n      "title": "Hypothesis",\n      "summary": "A function h : X → Y that acts as a predictor for the target value y given an input x.",\n      "context": "Framed as the primary goal of supervised learning: to learn a function that is a \'good\' predictor.",\n      "prerequisite_ids": [\n        "supervised-learning-fundamentals-input-features-and-target-variable"\n
      ],\n      "evidence": [\n        {\n          "page": 2,\n          "section": "Supervised learning",\n          "excerpt": "our goal is, given a training set, to learn a function h :X↦→Y so that h(x) is a “good” predictor for the corresponding value of y. For historical reasons, this function h is called a hypothesis."\n
        }\n
      ]\n
    },\n    {\n      "id": "supervised-learning-fundamentals-regression-problem",\n      "topic_id": "supervised-learning-fundamentals",\n      "title": "Regression Problem",\n      "summary": "A type of supervised learning where the target variable being predicted is continuous.",\n      "context": "Used to categorize learning problems based on the nature of the output variable.",\n      "prerequisite_ids": [],\n      "evidence": [\n        {\n          "page": 2,\n          "section": "Supervised learning",\n          "excerpt": "When the target variable that we’re trying to predict is continuous, such as in our housing example, we call the learning problem a regression problem."\n
        }\n
      ]\n
    },\n    {\n      "id": "supervised-learning-fundamentals-classification-problem",\n      "topic_id": "supervised-learning-fundamentals",\n      "title": "Classification Problem",\n      "summary": "A type of supervised learning where the target variable can take on only a small number of discrete values.",\n      "context": "Used to categorize learning problems where the output is a discrete category rather than a continuous value.",\n      "prerequisite_ids": [],\n      "evidence": [\n        {\n          "page": 2,\n          "section": "Supervised learning",\n          "excerpt": "When y can take on only a small number of discrete values (such as if, given the living area, we wanted to predict if a dwelling is a house or an apartment, say), we call it a classiﬁcation problem."\n
        }\n
      ]\n
    },\n    {\n      "id": "linear-regression-model-parameters-weights",\n      "topic_id": "linear-regression-model",\n      "title": "Parameters (Weights)",\n      "summary": "The coefficients θi that parameterize the space of linear functions mapping from input features to the target variable.",\n      "context": "These values define the specific linear hypothesis and are the variables that the learning algorithm optimizes to minimize the cost function.",\n      "prerequisite_ids": [\n        "supervised-learning-fundamentals-hypothesis"\n
      ],\n      "evidence": [\n        {\n          "page": 3,\n          "section": "Linear Regression",\n          "excerpt": "the θi’s are the parameters (also called weights) parameterizing the space of linear functions mapping from X to Y."\n
        }\n
      ]\n
    },\n    {\n      "id": "linear-regression-model-intercept-term",\n      "topic_id": "linear-regression-model",\n      "title": "Intercept Term",\n      "summary": "A convention where an additional input feature x0 is set to 1, allowing the bias term θ0 to be included in the vector notation of the hypothesis.",\n      "context": "Used to simplify the mathematical representation of the linear hypothesis into a dot product (θTx).",\n      "prerequisite_ids": [\n        "linear-regression-model-parameters-weights"\n
      ],\n      "evidence": [\n        {\n          "page": 3,\n          "section": "Linear Regression",\n          "excerpt": "To simplify our notation, we also introduce the convention of letting x0 = 1 (this is the intercept term)"\n
        }\n
      ]\n
    },\n    {\n      "id": "linear-regression-model-least-squares-cost-function",\n      "topic_id": "linear-regression-model",\n      "title": "Least-Squares Cost Function",\n      "summary": "A function J(θ) that measures the sum of squared differences between the model\'s predictions and the actual target values in the training set.",\n      "context": "This function provides a formal measure of how close the hypothesis h(x) is to the target y, serving as the objective to be minimized during optimization.",\n      "prerequisite_ids": [\n        "supervised-learning-fundamentals-hypothesis",\n        "supervised-learning-fundamentals-training-example-and-training-set"\n
      ],\n      "evidence": [\n        {\n          "page": 4,\n          "section": "Linear Regression",\n          "excerpt": "We define the cost function: J(θ) = 1/2 ∑ (hθ(x(i))−y(i))2."\n
        },\n        {\n          "page": 4,\n          "section": "Linear Regression",\n          "excerpt": "you may recognize this as the familiar least-squares cost function that gives rise to the ordinary least squares regression model."\n
        }\n
      ]\n
    },\n    {\n      "id": "gradient-descent-optimization-lms-update-rule",\n      "topic_id": "gradient-descent-optimization",\n      "title": "LMS Update Rule",\n      "summary": "Also known as the Widrow-Hoff learning rule, this is a parameter update method where the magnitude of the change is proportional to the error between the model\'s prediction and the actual target value.",\n      "context": "Derived as the gradient descent update for a single training example, it serves as the fundamental building block for both batch and stochastic gradient descent.",\n      "prerequisite_ids": [\n        "linear-regression-model-least-squares-cost-function",\n        "linear-regression-model-parameters-weights"\n
      ],\n      "evidence": [\n        {\n          "page": 5,\n          "section": "1 LMS algorithm",\n          "excerpt": "The rule is called the LMS update rule (LMS stands for “least mean squares”), and is also known as the Widrow-Hoff learning rule."\n
        },\n        {\n          "page": 5,\n          "section": "1 LMS algorithm",\n          "excerpt": "the magnitude of the update is proportional to the error term (y(i)−hθ(x(i))); thus, for instance, if we are encountering a training example on which our prediction nearly matches the actual value of y(i), then we find that there is little need to change the parameters"\n
        }\n
      ]\n
    },\n    {\n      "id": "gradient-descent-optimization-learning-rate",\n      "topic_id": "gradient-descent-optimization",\n      "title": "Learning Rate",\n      "summary": "A scalar parameter (denoted as α) that controls the step size taken in the direction of steepest decrease during each iteration of gradient descent.",\n      "context": "It is a critical hyperparameter; if the learning rate is too large, the algorithm may fail to converge to the global minimum.",\n      "prerequisite_ids": [],\n      "evidence": [\n        {\n          "page": 5,\n          "section": "1 LMS algorithm",\n          "excerpt": "Here, α is called the learning rate."\n
        },\n        {\n          "page": 6,\n          "section": "1 LMS algorithm",\n          "excerpt": "gradient descent always converges (assuming the learning rate α is not too large) to the global minimum."\n
        }\n
      ]\n
    },\n    {\n      "id": "gradient-descent-optimization-batch-gradient-descent",\n      "topic_id": "gradient-descent-optimization",\n      "title": "Batch Gradient Descent",\n      "summary": "An optimization approach that calculates the gradient of the cost function using every example in the entire training set before performing a single update to the parameters.",\n      "context": "While guaranteed to converge to the global minimum for convex quadratic functions, it can be computationally costly when the training set size (n) is large.",\n      "prerequisite_ids": [\n        "gradient-descent-optimization-lms-update-rule",\n        "gradient-descent-optimization-learning-rate"\n
      ],\n      "evidence": [\n        {\n          "page": 6,\n          "section": "1 LMS algorithm",\n          "excerpt": "This method looks at every example in the entire training set on every step, and is called batch gradient descent."\n
        }\n
      ]\n
    },\n    {\n      "id": "gradient-descent-optimization-stochastic-gradient-descent",\n      "topic_id": "gradient-descent-optimization",\n      "title": "Stochastic Gradient Descent",\n      "summary": "Also called incremental gradient descent, this method updates the model parameters immediately after processing each individual training example.",\n      "context": "It is often preferred over batch gradient descent for large datasets because it makes progress faster, although it may oscillate around the minimum rather than converging exactly to it.",\n      "prerequisite_ids": [\n        "gradient-descent-optimization-lms-update-rule",\n        "gradient-descent-optimization-learning-rate"\n
      ],\n      "evidence": [\n        {\n          "page": 7,\n          "section": "1 LMS algorithm",\n          "excerpt": "In this algorithm, we repeatedly run through the training set, and each time we encounter a training example, we update the parameters according to the gradient of the error with respect to that single training example only. This algorithm is called stochastic gradient descent (also incremental gradient descent)."\n
        },\n        {\n          "page": 7,\n          "section": "1 LMS algorithm",\n          "excerpt": "Whereas batch gradient descent has to scan through the entire training set before taking a single step—a costly operation if n is large—stochastic gradient descent can start making progress right away"\n
        }\n
      ]\n
    },\n    {\n      "id": "the-normal-equations-matrix-derivatives",\n      "topic_id": "the-normal-equations",\n      "title": "Matrix Derivatives",\n      "summary": "A method for calculating the gradient of a function that maps matrices to real numbers, resulting in a matrix of the same dimensions as the input where each element is the partial derivative with respect to the corresponding matrix entry.",\n      "context": "Introduced as a mathematical tool to enable the explicit minimization of the cost function J(θ) without requiring extensive manual algebra.",\n      "prerequisite_ids": [],\n      "evidence": [\n        {\n          "page": 8,\n          "section": "2.1 Matrix derivatives",\n          "excerpt": "For a function f : Rn×d ↦→ R mapping from n-by-d matrices to the real numbers, we define the derivative of f with respect to A to be: ∇Af(A) = [ ∂f/∂A11 ... ∂f/∂A1d ... ... ... ∂f/∂An1 ... ∂f/∂And ]"\n
        }\n
      ]\n
    },\n    {\n      "id": "the-normal-equations-design-matrix",\n      "topic_id": "the-normal-equations",\n      "title": "Design Matrix",\n      "summary": "An n-by-d matrix (or n-by-d+1 if including the intercept term) that organizes the input features of all training examples, with each row representing a single example.",\n      "context": "Used to rewrite the least-squares cost function in matrix-vectorial notation, which simplifies the process of finding the derivative with respect to the parameter vector θ.",\n      "prerequisite_ids": [\n        "supervised-learning-fundamentals-training-example-and-training-set",\n        "linear-regression-model-intercept-term"\n
      ],\n      "evidence": [\n        {\n          "page": 9,\n          "section": "2.2 Least squares revisited",\n          "excerpt": "define the design matrix X to be the n-by-d matrix (actually n-by-d + 1, if we include the intercept term) that contains the training examples’ input values in its rows"\n
        }\n
      ]\n
    },\n    {\n      "id": "the-normal-equations-closed-form-solution",\n      "topic_id": "the-normal-equations",\n      "title": "Closed-form Solution",\n      "summary": "An analytical expression, θ = (XTX)−1XTy, that directly calculates the optimal parameter vector θ that minimizes the cost function without the need for iterative search.",\n      "context": "Presented as the final result of solving the normal equations, providing a direct way to find the global minimum of the convex quadratic cost function J.",\n      "prerequisite_ids": [\n        "the-normal-equations-design-matrix",\n        "the-normal-equations-matrix-derivatives",\n        "linear-regression-model-least-squares-cost-function"\n
      ],\n      "evidence": [\n        {\n          "page": 10,\n          "section": "2.2 Least squares revisited",\n          "excerpt": "the value of θ that minimizes J(θ) is given in closed form by the equation θ = (XTX)−1XTy"\n
        }\n
      ]\n
    },\n    {\n      "id": "probabilistic-interpretation-error-term",\n      "topic_id": "probabilistic-interpretation",\n      "title": "Error Term",\n      "summary": "A variable denoted as ε(i) that accounts for random noise or unmodeled effects not captured by the input features in the linear relationship between x and y.",\n      "context": "Introduced to explain the discrepancy between the actual target value and the linear prediction θTx.",\n      "prerequisite_ids": [\n        "supervised-learning-fundamentals-hypothesis"\n
      ],\n      "evidence": [\n        {\n          "page": 10,\n          "section": "3 Probabilistic interpretation",\n          "excerpt": "where ε(i) is an error term that captures either unmodeled eﬀects (such as if there are some features very pertinent to predicting housing price, but that we’d left out of the regression), or random noise."\n
        }\n
      ]\n
    },\n    {\n      "id": "probabilistic-interpretation-iid-gaussian-noise-assumption",\n      "topic_id": "probabilistic-interpretation",\n      "title": "IID Gaussian Noise Assumption",\n      "summary": "The assumption that error terms are independently and identically distributed (IID) according to a Gaussian (Normal) distribution with a mean of zero and a variance σ².",\n      "context": "This assumption serves as the theoretical basis for deriving the least-squares cost function from a probabilistic perspective.",\n      "prerequisite_ids": [\n        "probabilistic-interpretation-error-term"\n
      ],\n      "evidence": [\n        {\n          "page": 10,\n          "section": "3 Probabilistic interpretation",\n          "excerpt": "Let us further assume that the ε(i) are distributed IID (independently and identically distributed) according to a Gaussian distribution (also called a Normal distribution) with mean zero and some variance σ2."\n
        }\n
      ]\n
    },\n    {\n      "id": "probabilistic-interpretation-conditional-probability-of-the-target",\n      "topic_id": "probabilistic-interpretation",\n      "title": "Conditional Probability of the Target",\n      "summary": "The probability density of the target variable y given the input x and parameters θ, which takes the form of a Gaussian distribution centered at the linear prediction.",\n      "context": "Used to formally express the likelihood of observing a specific target value given the model\'s parameters and the noise assumption.",\n      "prerequisite_ids": [\n        "probabilistic-interpretation-iid-gaussian-noise-assumption",\n        "supervised-learning-fundamentals-hypothesis"\n
      ],\n      "evidence": [\n        {\n          "page": 10,\n          "section": "3 Probabilistic interpretation",\n          "excerpt": "This implies that p(y(i)|x(i);θ) = 1/√2πσ exp(-(y(i)−θTx(i))2 / 2σ2)."\n
        }\n
      ]\n
    }\n
  ]\n
